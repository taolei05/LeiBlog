{
	servers {
		# Only Cloudflare may supply visitor IPs. Direct requests cannot spoof them.
		# https://www.cloudflare.com/ips-v4 / https://www.cloudflare.com/ips-v6
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(static_security) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Cache-Control "no-store"
	}
}

{$SITE_HOST} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@private path /.env* /.git* /.sl* /node_modules/* /source/* /deploy/*
	respond @private 404
	@untrusted not vars trusted_proxy true
	request_header @untrusted -CF-IPCountry
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
			header_up X-Leiblog-Country-Code {http.request.header.CF-IPCountry}
		}
	}
	handle /uploads/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
			header_up X-Leiblog-Country-Code {http.request.header.CF-IPCountry}
		}
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@admin path /admin /admin/*
	handle @admin {
		import static_security
		try_files {path} /admin/index.html
		file_server
	}
	handle {
		import static_security
		try_files {path} /index.html
		file_server
	}
}
