PORT=3000
HOSTNAME=0.0.0.0
# Set to the canonical HTTPS domain behind the production reverse proxy.
# PUBLIC_SITE_URL=https://blog.example.com
DATABASE_URL=postgres://leiblog:12345678@127.0.0.1:5432/leiblog
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,/^http:\/\/192\.168\.\d{1,3}\.\d{1,3}:5174$/
# Production requires explicit HTTPS origins and unique secrets of at least 32 characters.
JWT_SECRET=change-this-jwt-secret
CONFIG_ENCRYPTION_SECRET=change-this-config-encryption-secret
ALTCHA_SECRET=change-this-altcha-secret
SESSION_TTL_SECONDS=604800
TRUSTED_PROXY_IPS=127.0.0.1,::1
UPLOADS_DIR=uploads
UPLOADS_URL_PREFIX=/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=20971520

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=LeiBlog Admin
ADMIN_BOOTSTRAP_TAGS=administrator,author
